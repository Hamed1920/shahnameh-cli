# Copy to .env.local. Never commit .env.local.

# Login is off unless this is "on".
# SHM_AUTH=on

# Local Postgres (docker-compose.db.yml). For Supabase use its direct or session-pooler
# connection string instead (not the transaction pooler).
DATABASE_URL=postgres://fmfd:fmfd@localhost:5433/fmfd

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3000

# Reviewer name stamped on decisions made with login off.
SHM_REVIEWER=

# After db:migrate: npm run auth:add-user -- --email you@example.com --name "Hamed" --role owner
